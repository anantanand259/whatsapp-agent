# Local mode writes outbound messages to data/outbox; it never contacts WhatsApp.
MODE=local
# After configuring the AI key and owner number, set MODE=personal to link your account.
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
COMMAND_PREFIX=!agent
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
OWNER_NUMBERS=
OPENAI_API_KEY=
# Set an available Responses API model with function calling.
OPENAI_MODEL=
MAX_AGENT_STEPS=16
# Live WhatsApp Cloud API settings. Use a Graph version supported by your app.
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Additional recipients the owner permits sending to, international digits only.
ALLOWED_RECIPIENTS=
# Replies to these contacts are automatic. They cannot invoke tools.
AUTO_REPLY_NUMBERS=
AUTO_REPLY_INSTRUCTIONS=You are an automated assistant. Acknowledge the message briefly and say the owner will review it. Do not make commitments on the owner's behalf.
# Restrict GitHub access to exactly one existing repository and branch.
GITHUB_TOKEN=
GITHUB_REPOSITORY=anantanand259/whatsapp-agent
GITHUB_BRANCH=agent-work
